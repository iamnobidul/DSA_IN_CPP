#include<iostream>
#include<vector>
using namespace std;
void print(vector<int> &arr){
    for(int ele : arr){
        cout<<ele<<" ";
    }
    cout<<endl;
}                       
int main(){
    vector<int> arr ={5,4,3,6,2,1};
    int n = arr.size();
    print(arr);
    for(int i=0;i<=n-1;i++){ //n-1 passes
        int swaps=0;
        for(int j=0;j<n-1-i;j++){   //AVG TC =O(n^2)
          if(arr[j]>arr[j+1]){      //BEST TC =O(n)
                swap(arr[j],arr[j+1]);
                swaps++;
            }
        }
        if(swaps==0) break;
    }
    print(arr);
}
